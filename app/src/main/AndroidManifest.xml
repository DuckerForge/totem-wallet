<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="com.solanamobile.seedvault.ACCESS_SEED_VAULT" />

    <!-- Package visibility (Android 11+): see the Seed Vault provider/activities. -->
    <queries>
        <!-- Store intel: read version/installer of the (launcher) app that opened us. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.solanamobile.dappstore" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="solanadappstore" />
        </intent>
        <package android:name="com.solanamobile.seedvault" />
        <package android:name="com.solanamobile.seedvaultimpl" />
        <provider android:authorities="com.solanamobile.seedvault.wallet.v1.walletprovider" />
        <intent>
            <action android:name="com.solanamobile.seedvault.wallet.v1.ACTION_AUTHORIZE_SEED_ACCESS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClearSign">

        <!-- Exports (CSV/PDF/JSON) are shared from cacheDir/exports through this provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="ClearSign"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ClearSign.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mobile Wallet Adapter endpoint: dApps route solana-wallet:// here. -->
        <!-- Portrait + configChanges: a recreation would drop the live MWA session
             and the in-flight Seed Vault result. -->
        <activity
            android:name=".MobileWalletAdapterActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection"
            android:theme="@style/Theme.ClearSign.Splash">
            <intent-filter android:label="ClearSign">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="solana-wallet" />
            </intent-filter>
        </activity>
    </application>
</manifest>
