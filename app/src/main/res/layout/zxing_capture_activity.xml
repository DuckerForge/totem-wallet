<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the scanner layout the zxing library ships, for one reason: its own
  screen offers no way out except the system back gesture, which is not something
  a person should have to guess while pointing a camera at someone else's phone.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/apex_scan_close"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_margin="18dp"
        android:background="#99000000"
        android:contentDescription="@string/close"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFF" />
</FrameLayout>
