    <string name="prot_title">Le tue difese</string>
    <string name="prot_intro">Ogni voce qui sotto è implementata e attiva in questa build. Nessuna firma parte prima che siano passate tutte.</string>
    <string name="p_sim_t">Simula ogni transazione on-chain</string>
    <string name="p_sim_b">I byte veri vengono eseguiti dalla rete prima che tu li veda: v0, lookup table, ogni programma. Ciò che vedi è ciò che succederà.</string>
    <string name="p_receipt_t">Ricevuta in linguaggio umano</string>
    <string name="p_receipt_b">Quanto esce, a chi, la commissione, e ogni split nascosto su più wallet (fee, referral, rent).</string>
    <string name="p_risks_t">Motore dei rischi</string>
    <string name="p_risks_b">Drainer, approvazioni illimitate, cambi di autorità, chiusure account, presa del wallet, durable nonce, trucchi gasless, svuotamento saldo, fee eccessive.</string>
    <string name="p_toctou_t">Ri-simulazione un istante prima della firma</string>
    <string name="p_toctou_b">Anti-TOCTOU: se l\'esito è cambiato rispetto all\'anteprima, la firma viene rifiutata.</string>
    <string name="p_blocklist_t">Blocklist locale</string>
    <string name="p_blocklist_b">Drainer noti, indirizzi burn e sanzionati confrontati offline con ogni indirizzo toccato dalla transazione.</string>
    <string name="p_lookalike_t">Rilevamento address-poisoning</string>
    <string name="p_lookalike_b">Un destinatario che somiglia a uno che conosci (stesse estremità visibili, indirizzo diverso) viene segnalato.</string>
    <string name="p_intel_t">Intelligence sul destinatario</string>
    <string name="p_intel_b">Storico, età e tipo del destinatario: un wallet nuovo di zecca che riceve tutto il tuo SOL è un allarme.</string>
    <string name="p_trace_t">Scan attività di qualsiasi indirizzo</string>
    <string name="p_trace_b">Cosa fa, con chi, quali programmi; finanziamento da exchange; schemi di payout e a imbuto.</string>
    <string name="p_community_t">Reputazione della community</string>
    <string name="p_community_b">Voti on-chain pesati sullo stake segnalano gli indirizzi truffa.</string>
    <string name="p_idl_t">Decodifica i programmi sconosciuti</string>
    <string name="p_idl_b">L\'IDL pubblicato dal programma trasforma dati opachi nel metodo e negli argomenti chiamati.</string>
    <string name="p_fee_t">Controllo delle commissioni</string>
    <string name="p_fee_b">Una priority fee molto sopra quella che la rete sta pagando viene evidenziata.</string>
    <string name="p_dapp_t">Identità e memoria della dApp</string>
    <string name="p_dapp_b">Dominio, avviso prima volta, storico firme, origine store, versione e date di aggiornamento.</string>
    <string name="p_hw_t">Firma hardware</string>
    <string name="p_hw_b">Le chiavi vivono nel Seed Vault del Seeker; ogni firma richiede la tua biometria. L\'app non vede mai una chiave.</string>
    <string name="p_hold_t">Tieni premuto per firmare</string>
    <string name="p_hold_b">Niente tap accidentali: tieni premuto un secondo per confermare, con tick aptici.</string>
    <string name="p_bundle_t">Bundle rivisti uno per uno</string>
    <string name="p_bundle_b">Ogni transazione di una richiesta multipla viene mostrata; una transazione pericolosa le blocca tutte.</string>
    <string name="p_attest_t">Ricevute attestate</string>
    <string name="p_attest_b">Ogni ricevuta approvata è firmata da una chiave hardware dell\'app: prova esportabile di ciò che ti è stato mostrato.</string>
    <string name="p_hygiene_t">Igiene del wallet</string>
    <string name="p_hygiene_b">Revoca le deleghe token rimaste, chiudi gli account vuoti e recupera il rent.</string>
    <string name="p_privacy_t">Privacy</string>
    <string name="p_privacy_b">Nulla lascia il telefono tranne le chiamate RPC/API necessarie alla verifica. Nessun account, nessun tracciamento.</string>
