    <string name="prot_row_sub">%1$d active defenses · %2$d risk types recognized</string>
    <string name="prot_title">Your defenses</string>
    <string name="prot_intro">Every item below is implemented and active in this build. Nothing is signed before all of them have run.</string>
    <string name="p_sim_t">Simulates every transaction on-chain</string>
    <string name="p_sim_b">The real bytes are run by the network before you see them: v0, lookup tables, every program. What you see is what will happen.</string>
    <string name="p_receipt_t">Plain-language receipt</string>
    <string name="p_receipt_b">How much leaves, to whom, the network fee, and every hidden split across multiple wallets (fees, referrals, rent).</string>
    <string name="p_risks_t">Risk engine</string>
    <string name="p_risks_b">Drainers, unlimited approvals, authority changes, account closes, wallet takeover, durable nonces, gasless tricks, balance drains, excessive fees.</string>
    <string name="p_toctou_t">Re-simulation right before signing</string>
    <string name="p_toctou_b">Anti-TOCTOU: if the outcome drifted since the preview, the signature is refused.</string>
    <string name="p_blocklist_t">Local blocklist</string>
    <string name="p_blocklist_b">Known drainers, burn addresses and sanctioned addresses are matched offline against every address a transaction touches.</string>
    <string name="p_lookalike_t">Address-poisoning detection</string>
    <string name="p_lookalike_b">A recipient that looks like one you know (same visible ends, different address) is flagged.</string>
    <string name="p_intel_t">Recipient intelligence</string>
    <string name="p_intel_b">History, age and type of the recipient: a brand-new wallet receiving all your SOL is a red flag.</string>
    <string name="p_trace_t">Activity scan of any address</string>
    <string name="p_trace_b">What it does, with whom, which programs; exchange funding; payout and funnel patterns.</string>
    <string name="p_community_t">Community reputation</string>
    <string name="p_community_b">Stake-weighted on-chain votes flag scam addresses.</string>
    <string name="p_idl_t">Decodes unknown programs</string>
    <string name="p_idl_b">The program\'s published IDL turns opaque data into the method and arguments being called.</string>
    <string name="p_fee_t">Fee sanity</string>
    <string name="p_fee_b">A priority fee far above what the network is paying is called out.</string>
    <string name="p_dapp_t">dApp identity and memory</string>
    <string name="p_dapp_b">Domain, first-time warning, signature history, store origin, version and update dates.</string>
    <string name="p_hw_t">Hardware signing</string>
    <string name="p_hw_b">Keys live in the Seeker\'s Seed Vault; every signature needs your biometrics. The app never sees a key.</string>
    <string name="p_hold_t">Hold to sign</string>
    <string name="p_hold_b">No accidental taps: you hold for a second to commit, with haptic checkpoints.</string>
    <string name="p_bundle_t">Bundles reviewed one by one</string>
    <string name="p_bundle_b">Every transaction of a multi-signature request is shown; one dangerous transaction blocks all of them.</string>
    <string name="p_attest_t">Attested receipts</string>
    <string name="p_attest_b">Each approved receipt is signed by a hardware key of this app: exportable proof of what you were shown.</string>
    <string name="p_hygiene_t">Wallet hygiene</string>
    <string name="p_hygiene_b">Revoke leftover token delegations, close empty accounts and reclaim rent.</string>
    <string name="p_privacy_t">Privacy</string>
    <string name="p_privacy_b">Nothing leaves the phone except the RPC/API calls needed for verification. No accounts, no tracking.</string>
