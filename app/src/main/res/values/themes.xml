<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="halo_ground">#070B12</color>
    <color name="apex_paper">#C9CCDA</color>
    <color name="halo_mint">#4DFFD0</color>

    <!-- Dependency-free base theme; the Compose Halo theme paints the UI.
         windowBackground = Halo ground, so there is no black flash before Compose. -->
    <style name="Theme.ClearSign" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/halo_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Branded cold start: the mark on its own ground, then hands over to Theme.ClearSign. -->
    <style name="Theme.ClearSign.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/halo_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/brand_bird</item>
        <item name="postSplashScreenTheme">@style/Theme.ClearSign</item>
    </style>
</resources>
