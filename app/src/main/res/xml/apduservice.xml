<?xml version="1.0" encoding="utf-8"?>
<!--
  The NFC Forum NDEF application. Claiming this AID is what makes another
  phone's reader talk to us as if we were a tag. Nothing else is claimed:
  no payment AID, no bank application.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/tap_service_desc"
    android:requireDeviceUnlock="false"
    android:apduServiceBanner="@mipmap/ic_launcher">
    <aid-group android:description="@string/tap_aid_desc" android:category="other">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
