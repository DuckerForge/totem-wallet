<?xml version="1.0" encoding="utf-8"?>
<!-- minWidth/minHeight are the smallest the launcher will allow; minResize* is how
     far the user can shrink it by dragging, and it was minResizeHeight that stopped
     the drag short of a single thin strip. 40dp is about one launcher row, which is
     as flat as a widget is allowed to be. targetCell* gives the comfortable default. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="240dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_desc"
    android:previewImage="@drawable/widget_preview"
    android:initialLayout="@layout/glance_default_loading_layout" />
