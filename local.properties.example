## Copy to local.properties and fill in. local.properties is git-ignored (holds secrets).
sdk.dir=/path/to/Android/Sdk

# Dedicated mainnet RPC (Helius or similar). Leave blank to use public nodes.
clearsign.heliusRpcUrl=

# Wallet (base58) that receives SKR for ClearSign Pro. Blank = purchases disabled.
clearsign.skrTreasury=

# RocketX partner key (free at app.rocketx.exchange/partner).
#
# Leave it here and the phone talks to RocketX directly, key compiled into the
# APK where anybody can pull it out and spend your quota.
#
# Leave it blank and, if clearsign.crowdUrl is set, the phone goes through the
# worker instead and the key lives there (`npx wrangler secret put RX_KEY`).
# That takes the key out of the APK, and it puts our own service in the middle
# of the answer that carries the deposit address: one more party that could
# swap it, where before there was only RocketX. A quota problem traded for a
# money problem. Your call, which is why it is a line here and not a decision
# in the code.
#
# Both blank = the bridge is off.
clearsign.rocketxKey=

# Jupiter referral account (made once at referral.jup.ag with the treasury wallet).
# Blank = no fee is taken on Ultra swaps.
clearsign.jupReferral=

# The crowd service (Cloudflare worker in tools/seeker-worker). Blank = Scout is off.
clearsign.crowdUrl=

# The shared archive that holds what a wallet owns, read with no key. The worker
# fills it; the phone reads it first and only bothers the worker when a wallet is
# missing or half a day old. Blank = every read goes through the worker.
clearsign.archiveUrl=https://<your-project>-default-rtdb.<region>.firebasedatabase.app

# Release signing. Without these four lines the release build falls back to the
# debug key, which still sideloads but cannot be published. Make the key once:
#   keytool -genkeypair -v -keystore ~/.android/seeker-release.jks \
#     -alias seeker -keyalg RSA -keysize 4096 -validity 10000
# Keep that file and its password forever: the store ties the app to this key.
clearsign.storeFile=
clearsign.storePassword=
clearsign.keyAlias=
clearsign.keyPassword=
